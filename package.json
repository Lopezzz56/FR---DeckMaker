{
  "name": "focusrealm-deckmaker",
  "version": "1.0.0",
  "description": "AI-Powered Enterprise Presentation Generator for FocusRealm",
  "main": "server/src/index.ts",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "vercel-build": "npm --prefix client run build",
    "start": "npm --prefix server run start"
  },
  "keywords": [
    "focusrealm",
    "presentation-generator",
    "hospitality",
    "mise-hotel"
  ],
  "author": "FocusRealm Team",
  "dependencies": {
    "@google/genai": "^2.31.0",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "pptxgenjs": "^4.0.1",
    "puppeteer-core": "^25.16.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@vercel/node": "^3.2.30",
    "concurrently": "^9.1.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
